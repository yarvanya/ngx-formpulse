{
  "name": "ngx-formpulse-workspace",
  "version": "0.0.0",
  "description": "Workspace of ngx-formpulse: the library, its sandbox documentation site and quality gates.",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "ng serve sandbox",
    "build": "npm run build:library && npm run build:sandbox",
    "build:library": "ng build ngx-formpulse",
    "build:sandbox": "ng build sandbox",
    "lint": "eslint .",
    "typecheck": "tsc -p projects/ngx-formpulse/tsconfig.lib.json --noEmit && tsc -p projects/ngx-formpulse/tsconfig.spec.json --noEmit && tsc -p tsconfig.tools.json",
    "test": "ng test ngx-formpulse --watch=false --coverage && vitest run --config vitest.tools.config.ts",
    "check:redos": "tsx tools/scripts/check-redos.ts",
    "size": "size-limit",
    "bench": "tsx tools/scripts/validators-benchmark.ts",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run check:test-mirror && npm run test && npm run check:redos && npm run build && npm run size && npm run bench && npm run e2e",
    "prepare": "husky",
    "check:test-mirror": "tsx tools/scripts/check-test-mirror.ts"
  },
  "lint-staged": {
    "*.{ts,mjs,html}": "eslint"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.1.2",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.6",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.2",
    "recheck": "^4.6.2",
    "serve": "^14.2.8",
    "size-limit": "^14.3.0",
    "tinybench": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
