      "@angular/core",
      "@angular/forms"
    ],
    "gzip": true,
    "limit": "1.5 KB"
  },
  {
    "name": "locale pack (uk)",
    "path": "dist/ngx-formpulse/fesm2022/ngx-formpulse-locales-uk.mjs",
