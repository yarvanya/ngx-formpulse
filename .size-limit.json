      "ngx-formpulse"
    ],
    "gzip": true,
    "limit": "1 KB"
  },
  {
    "name": "core + fpPostCode (validator and data for 174 countries)",
    "path": "dist/ngx-formpulse/fesm2022/ngx-formpulse.mjs",
    "import": "{provideFormPulse, fpPostCode}",
    "ignore": [
      "@angular/core",
      "@angular/forms"
    ],
    "gzip": true,
    "limit": "6 KB"
  },
  {
    "name": "core + fpEmail (validator and the shared message runtime)",
