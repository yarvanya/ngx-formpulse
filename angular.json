{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-formpulse": {
      "projectType": "library",
      "root": "projects/ngx-formpulse",
      "sourceRoot": "projects/ngx-formpulse",
      "prefix": "fp",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/ngx-formpulse/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-formpulse/tsconfig.spec.json",
            "runner": "vitest",
            "include": [
              "**/*.spec.ts"
            ],
            "coverageInclude": [
              "projects/ngx-formpulse/**/*.ts"
            ],
            "coverageExclude": [
              "**/public-api.ts",
              "**/*.spec.ts",
              "**/*.test-d.ts",
              "**/testing/**",
              "**/*.cases.ts"
            ],
            "coverageReporters": [
              "text",
              "html",
              "lcov"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            }
          }
        }
      }
    },
    "sandbox": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "projects/sandbox",
      "sourceRoot": "projects/sandbox/src",
      "prefix": "fp",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/sandbox/src/main.ts",
            "tsConfig": "projects/sandbox/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sandbox/public"
              }
            ],
            "styles": [
              "projects/sandbox/src/styles.scss"
            ],
            "server": "projects/sandbox/src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 1000
          },
          "configurations": {
            "production": {
              "buildTarget": "sandbox:build:production"
            },
            "development": {
              "buildTarget": "sandbox:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
