{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "module": "preserve",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "tools/**/*.ts",
    "tools/**/*.mjs",
    "e2e/**/*.ts",
    "*.config.ts",
    "*.config.mjs",
    "projects/ngx-formpulse/src/**/*.ts"
  ],
  "exclude": [
    "projects/ngx-formpulse/**/*.spec.ts",
    "projects/ngx-formpulse/**/*.test-d.ts"
  ]
}
